# Copy to .env and adjust. Local defaults match docker-compose.yml.
DATABASE_URL=postgres://studyloop:studyloop@localhost:5432/studyloop

# Admin connection used by the test harness to create a throwaway database per test run.
TEST_DATABASE_URL=postgres://studyloop:studyloop@localhost:5432/postgres

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: in-app issue reporting (owner only). Both must be set, or the "Report issue" control is hidden.
# A fine-grained token limited to this repository with Issues: read/write and Contents: read/write
# (Contents is for committing screenshots to the feedback-assets branch). It never reaches the browser.
ISSUE_REPORTING_GITHUB_TOKEN=
# The email on the owner's GitHub account (the one studyloop signs them in with). Only they see the control.
ISSUE_REPORTING_OWNER_EMAIL=
# Repository issues are posted to (default: ewc340/studyloop).
# ISSUE_REPORTING_REPOSITORY=owner/name
# App version shown in reports (default: the checked-out git commit).
# APP_VERSION=

# Test-only: lets Playwright act as a Learner without GitHub. The server refuses to start with this in production.
# E2E_AUTH_BYPASS=1
