# Copy to .env and adjust. Local defaults match docker-compose.yml.
DATABASE_URL=postgres://studyloop:studyloop@localhost:5432/studyloop

# Admin connection used by the test harness to create a throwaway database per test run.
TEST_DATABASE_URL=postgres://studyloop:studyloop@localhost:5432/postgres

# Test-only: lets Playwright act as a Learner without signing in. Ignored when NODE_ENV=production.
# E2E_AUTH_BYPASS=1
